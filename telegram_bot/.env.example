# ============================================================
#  Telegram Media Downloader Bot — Configuration
#  Copy this file to ".env" and fill in your values.
# ============================================================

# --- REQUIRED ---
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz

# --- OPTIONAL: Access control ---
# Comma-separated Telegram user IDs that are admins (full access).
# Leave empty to allow everyone.
ADMINS=

# Comma-separated user IDs allowed to use the bot. Empty = public.
ALLOWED_USERS=

# --- OPTIONAL: Limits ---
# Max file size to send (Telegram bot limit is 50 MB without a local Bot API server).
MAX_FILESIZE_MB=49

# Max number of search results shown for /find and /music
SEARCH_RESULTS=6

# Folder where files are downloaded temporarily (auto-created).
DOWNLOAD_DIR=downloads

# SQLite database file (users, stats, settings, file cache). Auto-created.
DB_PATH=bot.db

# --- OPTIONAL: Daily limit ---
# Max downloads per user per 24h (admins are exempt). 0 = unlimited.
DAILY_QUOTA=0

# --- OPTIONAL: Force-join (sponsor) channels ---
# Comma-separated channel usernames users MUST join before using the bot.
# The bot must be an ADMIN in each channel to check membership.
# Example: FORCE_JOIN_CHANNELS=@mychannel,@another
FORCE_JOIN_CHANNELS=

# --- OPTIONAL: Local Bot API server (lifts the 50 MB limit up to 2 GB) ---
# If you run a local telegram-bot-api server, set its URL here.
# BASE_URL=http://localhost:8081/bot
# BASE_FILE_URL=http://localhost:8081/file/bot

# --- OPTIONAL: yt-dlp cookies (for age-restricted / login-gated content) ---
# Path to a cookies.txt file exported from your browser.
# COOKIES_FILE=cookies.txt

# --- OPTIONAL: Proxy for restricted regions ---
# PROXY=socks5://127.0.0.1:1080
