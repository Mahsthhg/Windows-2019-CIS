# ─── توکن ربات‌ها ─────────────────────────────────────────────────────────────
CUSTOMER_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
ADMIN_BOT_TOKEN=9876543210:ZYXwvuTSRqpONMlkJIHgfeDCBA

# ─── ادمین ────────────────────────────────────────────────────────────────────
# آیدی اصلی ادمین (از @userinfobot بگیرید)
ADMIN_CHAT_ID=123456789
# چند ادمین با کاما (اختیاری): 123,456,789
ADMIN_IDS=123456789

# ─── اطلاعات پرداخت ───────────────────────────────────────────────────────────
CARD_NUMBER=5022291544985573
CARD_HOLDER=خلیلی
BANK_NAME=بانک ملت

# ─── تنظیمات ربات ─────────────────────────────────────────────────────────────
BOT_NAME=VPN Pro Shop
SUPPORT_USERNAME=@your_support
BOT_CHANNEL=@your_channel

# ─── جوین اجباری ──────────────────────────────────────────────────────────────
FORCE_JOIN_ENABLED=false
FORCE_JOIN_CHANNELS=@your_channel

# ─── قیمت‌گذاری ───────────────────────────────────────────────────────────────
# اینها در config.py تنظیم می‌شوند:
# PRICE_PER_GB = 5000
# MIN_GB = 20  |  MAX_GB = 500

# ─── کیف پول ──────────────────────────────────────────────────────────────────
# حداقل مبلغ شارژ (تومان)
WALLET_MIN_CHARGE=50000

# ─── سیستم معرفی ──────────────────────────────────────────────────────────────
# جایزه تومانی برای هر دو طرف (0 = غیرفعال)
REFERRAL_BONUS_TOMAN=0
# یا جایزه گیگابایتی (اگر TOMAN=0 باشد استفاده می‌شود)
REFERRAL_BONUS_GB=5

# ─── آزمایش رایگان ────────────────────────────────────────────────────────────
FREE_TRIAL_ENABLED=false
FREE_TRIAL_GB=5

# ─── پنل Marzban (اختیاری) ────────────────────────────────────────────────────
# اگر true باشد: هنگام تایید، کانفیگ اتوماتیک ساخته می‌شود
PANEL_ENABLED=false
PANEL_URL=https://your-panel.com
PANEL_USERNAME=admin
PANEL_PASSWORD=your_password
PANEL_INBOUND_TAG=vless-tcp-reality
PANEL_DEFAULT_DAYS=30

# ─── زمان‌بند ──────────────────────────────────────────────────────────────────
# ساعت ارسال گزارش روزانه (0-23)
DAILY_REPORT_HOUR=8
# چند روز قبل از انقضا یادآوری شود
EXPIRY_WARNING_DAYS=3

# ─── دیتابیس ─────────────────────────────────────────────────────────────────
DB_PATH=vpn_sales.db
